{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2024"
    ]
  },
  "include": [
    "src/cli.ts",
    "src/portless.ts",
    "src/proxy.ts",
    "src/server.ts",
    "src/settings.ts"
  ]
}
